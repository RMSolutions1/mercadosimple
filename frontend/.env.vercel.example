# Copiá estas variables en Vercel → Project → Settings → Environment Variables
# (Production / Preview según corresponda)

# URL pública del frontend (tu dominio o *.vercel.app)
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# URL de la API (proyecto backend en Vercel, Fly, o dominio propio) — debe terminar en /api
NEXT_PUBLIC_API_URL=https://tu-api.vercel.app/api

NEXT_PUBLIC_APP_NAME=Mercado Simple

# Opcional: sitemap/canonicals (si usás dominio custom)
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com.ar
