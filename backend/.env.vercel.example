# =============================================================================
# PROYECTO VERCEL: Root Directory = backend  (solo estas variables aquí)
# =============================================================================
# NO mezcles con el proyecto frontend. Si importaste un .env gigante, borrá:
#   PGADMIN_PASSWORD, NEXT_PUBLIC_* (van solo en el otro proyecto),
#   y DB_HOST/DB_PORT/... si usás DATABASE_URL.
# =============================================================================

NODE_ENV=production

# --- Base de datos (elegí UNA forma) ---
# Recomendado en Vercel: una sola URL (Neon, Supabase, Vercel Postgres…)
DATABASE_URL=postgresql://usuario:clave@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Si NO usás DATABASE_URL, entonces sí: DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD, DB_DATABASE, DB_SSL
# DB_HOST=
# DB_PORT=5432
# DB_USERNAME=
# DB_PASSWORD=
# DB_DATABASE=
# DB_SSL=true

# --- JWT (obligatorio) — generá con: openssl rand -base64 64 ---
JWT_SECRET=cambiar-por-secreto-largo-aleatorio
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-distinto
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- URLs ---
# Origen del navegador (sitio Next). Puede ser varios separados por coma.
FRONTEND_URL=https://tu-frontend.vercel.app

# Base pública de ESTA API (sin /api al final). Sirve para webhooks de Mercado Pago y links en emails.
APP_URL=https://tu-backend.vercel.app

# --- Admin (seed / primer login admin) ---
ADMIN_SEED_EMAIL=admin@tudominio.com
ADMIN_SEED_PASSWORD=clave-muy-segura-cambiar

# --- Email: Resend O SMTP (dejá vacío lo que no uses) ---
# Opción A — Resend
RESEND_API_KEY=
RESEND_FROM=Mercado Simple <onboarding@resend.dev>

# Opción B — SMTP (si usás Resend, dejá estos vacíos)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Mercado Pago (opcional hasta que cobres en producción) ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# --- Esquema DB en producción: false salvo que sepas lo que hacés ---
ALLOW_SYNC=false

# --- CORS extra (opcional) ---
# CORS_EXTRA_ORIGINS=https://www.tudominio.com.ar
# CORS_ALLOW_VERCEL_APP=true
