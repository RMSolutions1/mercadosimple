# Dueño del sitio (solo este usuario se crea con npm run seed / POST /admin/seed)
# En producción: definí una clave fuerte con fly secrets set ADMIN_SEED_PASSWORD="..."
ADMIN_SEED_EMAIL=admin@mercadosimple.com
ADMIN_SEED_PASSWORD=CambiarEstaClave2026!

# Solo local / CI: crea comprador@ y techstore@ y además el catálogo demo de productos (nunca en producción)
# SEED_DEMO_USERS=true

# Solo catálogo ficticio (ARS) para techstore@ si ya existe el usuario (sin recrear usuarios demo)
# SEED_DEMO_PRODUCTS=true

# Base de datos (local o DATABASE_URL en producción)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=mercadosimple
DB_PASSWORD=mercadosimple123
DB_DATABASE=mercadosimple
DB_SSL=false
# En Fly.io se usa DATABASE_URL (Postgres Managed)

# JWT (producción: generar con openssl rand -base64 64)
JWT_SECRET=reemplazar-con-secreto-seguro
JWT_REFRESH_SECRET=reemplazar-con-otro-secreto-seguro
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URLs de la app (incluí localhost y 127.0.0.1 si usás ambos en el navegador)
APP_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3002,http://127.0.0.1:3002,http://localhost:3000

# Email — Opción 1: Resend (recomendado para producción)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM="Mercado Simple <onboarding@resend.dev>"

# Email — Opción 2: SMTP
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Mercado Simple <noreply@tudominio.com>"

# Mercado Pago (producción: token real, no TEST-)
# MP_ACCESS_TOKEN=APP_USR-xxxx
# MP_PUBLIC_KEY=APP_USR-xxxx

# Opcional: sincronizar esquema en producción (por defecto false)
# ALLOW_SYNC=false
